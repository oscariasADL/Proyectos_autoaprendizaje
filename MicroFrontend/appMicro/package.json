{
  "name": "bavv-mb-frontend-app",
  "version": "4.36.0",
  "author": "Aval Digital Labs",
  "homepage": "https://ionicframework.com/",
  "description": "An Ionic project",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:img": "ng test --browsers=ChromeHeadlessCI --watch false --code-coverage",
    "lint": "ng lint",
    "build:stg": "npm run project-config:android:pre && ionic build -c stg && npx cap sync android",
    "analyzer": "ng build -c pro --stats-json && webpack-bundle-analyzer www/stats.json",
    "coverage": "ng test --watch=false --code-coverage && http-server coverage/ -o",
    "resources": "cordova-res ios && cordova-res android && node resources/resources.js",
    "precommit": "npm run lint && npm run prettier && npm run lint:html && npm run lint:sass",
    "postinstall": "jetifier",
    "ios": "npm run ios:pro",
    "ios:pro": "npm run project-config:ios:pro && ionic build -c pro && npx cap sync ios && npx cap open ios",
    "ios:dev": "npm run project-config:ios:pre && ionic build -c dev && npx cap sync ios && npx cap open ios",
    "ios:stg": "npm run project-config:ios:pre && ionic build -c stg && npx cap sync ios && npx cap open ios",
    "ios:mock": "npm run project-config:ios:pre && ionic build -c mock && npx cap sync ios && npx cap open ios",
    "ios:live": "npm run project-config:ios:pre && ionic capacitor run ios -l --external",
    "android": "npm run android:pro",
    "android:pro": "npm run project-config:android:pro && ionic build -c pro && npx cap sync android && npx cap open android",
    "android:dev": "npm run project-config:android:pre && ionic build -c dev && npx cap sync android && npx cap open android",
    "android:stg": "npm run project-config:android:pre && ionic build -c stg && npx cap sync android && npx cap open android",
    "android:mock": "npm run project-config:android:pre && ionic build -c mock && npx cap sync android && npx cap open android",
    "android:live": "npm run project-config:android:pre && ionic capacitor run android -l --external",
    "start:dev": "ionic serve --configuration=dev",
    "start:stg": "ionic serve --configuration=stg",
    "start:pro": "ionic serve --configuration=pro",
    "start:mock": "ionic serve --configuration=mock",
    "resource": "node resources/resources.js",
    "project-config:android:pre": "node project-config/project-config.js android pre",
    "project-config:android:pro": "node project-config/project-config.js android pro",
    "project-config:ios:pre": "node project-config/project-config.js ios pre",
    "project-config:ios:pro": "node project-config/project-config.js ios pro",
    "prettier:list": "prettier --list-different './{e2e,src}/**/*.{scss,ts}' || ECHO .",
    "prettier:write": "prettier --write '{e2e,test-helpers,src}/**/*.ts'",
    "prettier:write:sass": "prettier-stylelint --write 'src/**/*.sass'",
    "prettier": "prettier --check 'src/app/**/*.ts'",
    "tslint:check": "tslint-config-prettier-check ./tslint.json",
    "lint:html": "htmlhint src/**/*.html",
    "lint:sass": "stylelint src/app/**/**/*.sass --syntax sass",
    "compodoc": "npx compodoc -p tsconfig.app.json",
    "sonar": "sonar-scanner",
    "preinstall": "npx npm-force-resolutions",
    "run:all": "node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "cypress run",
    "e2e:headless": "cypress run --headless",
    "e2e:ci": "cypress run --headless --browser chrome",
    "e2e:spec": "cypress run --spec 'cypress/e2e/spec.cy.ts'",
    "e2e:parallel": "cypress run --parallel --record false"
  },
