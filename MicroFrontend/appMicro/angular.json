{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "aot": true,
            "outputPath": "www",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "allowedCommonJsDependencies": [
              "lodash",
              "date-fns",
              "crypto-js",
              "@babel/runtime-corejs3",
              "raf",
              "MPFingerprintV2"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/ionicons/dist/ionicons/svg",
                "output": "./svg"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@avaldigitallabs/adl-pfm-design-system-widgets/src/global/icons/bavv",
                "output": "./assets/img/pfm-icons/"
              }
            ],
            "styles": [
              {
                "input": "src/theme/variables.sass"
              },
              {
                "input": "src/global.sass"
              },
              {
                "input": "./node_modules/@avaldigitallabs/adl-pfm-design-system-widgets/src/global/styles/bavv/_bavv.scss"
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/sass"
              ]
            },
            "scripts": [
              "src/assets/js/fpd2.js"
            ],
            "extraWebpackConfig": "webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "pro": {
              "index": {
                "input": "src/index/index.pro.html",
                "output": "index.html"
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.dev.ts",
                  "with": "src/environments/environment.pro.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kb"
                }
              ],
              "stylePreprocessorOptions": {
                "includePaths": [
                  "src/sass"
                ]
              },
              "extraWebpackConfig": "webpack.prod.config.js"
            },
            "stg": {
              "index": {
                "input": "src/index/index.stg.html",
                "output": "index.html"
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.dev.ts",
                  "with": "src/environments/environment.stg.ts"
                }
              ],
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kb"
                }
              ],
              "stylePreprocessorOptions": {
                "includePaths": [
                  "src/sass"
                ]
              }
            },
            "dev": {
              "index": {
                "input": "src/index/index.dev.html",
                "output": "index.html"
              },
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": true,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kb"
                }
              ],
              "stylePreprocessorOptions": {
                "includePaths": [
                  "src/sass"
                ]
              }
            },
            "mock": {
              "buildOptimizer": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.dev.ts",
                  "with": "src/environments/environment.mock.ts"
                }
              ],
              "stylePreprocessorOptions": {
                "includePaths": [
                  "src/sass"
                ]
              }
            },
            "ci": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kb"
                }
              ],
              "progress": false
            }
          }
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "options": {
            "browserTarget": "app:build",
            "port": 8100,
            "publicHost": "http://localhost:8100",
            "extraWebpackConfig": "webpack.config.js"
          },
          "configurations": {
            "production": {
              "browserTarget": "app:build:production",
              "extraWebpackConfig": "webpack.prod.config.js"
            },
            "pro": {
              "browserTarget": "app:build:pro"
            },
            "mock": {
              "browserTarget": "app:build:mock"
            },
            "stg": {
              "browserTarget": "app:build:stg"
            },
            "dev": {
              "browserTarget": "app:build:dev"
            },
            "ci": {}
          }
        },
        "extract-i18n": {
          "builder": "ngx-build-plus:extract-i18n",
          "options": {
            "browserTarget": "app:build",
            "extraWebpackConfig": "webpack.config.js"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "codeCoverage": true,
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "styles": [],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/sass"
              ]
            },
            "scripts": [
              "src/assets/js/fpd2.js"
            ],
            "assets": [
              {
                "glob": "favicon.ico",
                "input": "src/",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              }
            ],
            "codeCoverageExclude": [
              "src/app/store/**/*",
              "src/app/**/*.action.ts",
              "src/app/**/*.effect.ts",
              "src/app/**/*.selector.ts",
              "src/app/**/*.state.ts",
              "src/app/**/*.reducer.ts",
              "src/app/**/*.facade.ts",
              "src/app/**/*.helper.ts",
              "src/app/**/*.helpers.ts",
              "src/app/**/*.mapper.ts",
              "src/app/**/*.interface.ts",
              "src/app/**/*.entities.ts",
              "src/app/**/*.constants.ts",
              "src/app/**/*.resolver.ts",
              "src/app/**/*.base.ts",
              "src/app/**/*.guard.ts",
              "src/app/**/*.animation.ts",
              "src/app/**/*.strategy.ts",
              "src/app/**/*.mock.ts",
              "src/app/**/utils/**",
              "src/app/**/directives/**",
              "src/app/**/guards/**",
              "src/app/**/interceptors/**",
              "src/app/**/capacitor-web-plugins/**",
              "src/app/**/feature-toggle.service.ts",
              "src/app/**/fill-otp-data.component.ts",
              "src/app/**/notifications-menu.component.ts",
              "src/app/**/product-action-tour.component.ts",
              "src/app/**/qr.service.ts",
              "src/app/**/qr-scan.service.ts",
              "src/app/**/scanner.service.ts",
              "src/app/**/barcode-scanner.service.ts",
              "src/app/**/barcode-scanner.component.ts",
              "src/app/**/wallet-sdk.service.ts",
              "src/app/**/forgot-password-strategy.factory.ts"
            ]
          },
          "configurations": {
            "ci": {
              "progress": false,
              "watch": false
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "app:serve",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production": {
              "devServerTarget": "app:serve:production"
            }
          }
        },
        "ionic-cordova-build": {
          "builder": "@ionic/angular-toolkit:cordova-build",
          "options": {
            "browserTarget": "app:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "app:build:production"
            },
            "pro": {
              "browserTarget": "app:build:pro"
            },
            "dev": {
              "browserTarget": "app:build:dev"
            },
            "stg": {
              "browserTarget": "app:build:stg"
            },
            "mock": {
              "browserTarget": "app:build:mock"
            }
          }
        },
        "ionic-cordova-serve": {
          "builder": "@ionic/angular-toolkit:cordova-serve",
          "options": {
            "cordovaBuildTarget": "app:ionic-cordova-build",
            "devServerTarget": "app:serve"
          },
          "configurations": {
            "production": {
              "cordovaBuildTarget": "app:ionic-cordova-build:production",
              "devServerTarget": "app:serve:production"
            }
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "app:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "app:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false
          }
        },
        "ct": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "app:serve",
            "watch": true,
            "headless": false,
            "testingType": "component"
          },
          "configurations": {
            "development": {
              "devServerTarget": "app:serve:development"
            }
          }
        }
      }
    },
    "bavv-mb-frontend-shell": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "sass"
        }
      },
      "root": "projects/bavv-mb-frontend-shell",
      "sourceRoot": "projects/bavv-mb-frontend-shell/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/bavv-mb-frontend-shell",
            "index": "projects/bavv-mb-frontend-shell/src/index.html",
            "main": "projects/bavv-mb-frontend-shell/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/bavv-mb-frontend-shell/tsconfig.app.json",
            "inlineStyleLanguage": "sass",
            "assets": [
              "projects/bavv-mb-frontend-shell/src/favicon.ico",
              "projects/bavv-mb-frontend-shell/src/assets"
            ],
            "styles": [
              "projects/bavv-mb-frontend-shell/src/styles.sass"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "bavv-mb-frontend-shell:build:production"
            },
            "development": {
              "browserTarget": "bavv-mb-frontend-shell:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "bavv-mb-frontend-shell:build"
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "bavv-mb-frontend-shell:serve",
            "configFile": "projects/bavv-mb-frontend-shell/cypress.config.js"
          },
          "configurations": {
            "production": {
              "devServerTarget": "bavv-mb-frontend-shell:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false,
            "configFile": "projects/bavv-mb-frontend-shell/cypress.config.js"
          }
        },
        "ct": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "bavv-mb-frontend-shell:serve",
            "watch": true,
            "headless": false,
            "testingType": "component"
          },
          "configurations": {
            "development": {
              "devServerTarget": "bavv-mb-frontend-shell:serve:development"
            }
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "bavv-mb-frontend-shell:serve",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production": {
              "devServerTarget": "bavv-mb-frontend-shell:serve:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "@cypress/schematic",
      "@ionic/angular-toolkit",
      "@schematics/angular"
    ],
    "analytics": false
  },
  "schematics": {
    "@ionic/angular-toolkit:component": {
      "styleext": "sass",
      "changeDetection": "OnPush"
    },
    "@ionic/angular-toolkit:page": {
      "styleext": "sass",
      "changeDetection": "OnPush"
    },
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    }
  }
}
