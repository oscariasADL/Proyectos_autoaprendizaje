{
  "name": "adl-prettier-linter",
  "version": "2.0.0",
  "description": "Conjunto de configuraciones reutilizables para ESLint, Prettier y Stylelint en proyectos JavaScript/TypeScript de ADL.",
  "author": "Sebastian Mateus <sebastian.mateus@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/adl-prettier-linter.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/adl-prettier-linter/issues"
  },
  "homepage": "https://github.com/your-org/adl-prettier-linter#readme",
  "keywords": [
    "eslint-config",
    "prettier-config",
    "stylelint-config",
    "eslint",
    "prettier",
    "stylelint",
    "adl",
    "config"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./configs/eslint": {
      "types": "./dist/configs/eslint/index.d.ts",
      "import": "./dist/configs/eslint/index.js",
      "require": "./dist/configs/eslint/index.cjs"
    },
    "./configs/eslint/base": {
      "types": "./dist/configs/eslint/base.d.ts",
      "import": "./dist/configs/eslint/base.js",
      "require": "./dist/configs/eslint/base.cjs"
    },
    "./configs/eslint/react": {
      "types": "./dist/configs/eslint/react.d.ts",
      "import": "./dist/configs/eslint/react.js",
      "require": "./dist/configs/eslint/react.cjs"
    },
    "./configs/eslint/angular": {
      "types": "./dist/configs/eslint/angular.d.ts",
      "import": "./dist/configs/eslint/angular.js",
      "require": "./dist/configs/eslint/angular.cjs"
    },
    "./configs/eslint/node": {
      "types": "./dist/configs/eslint/node.d.ts",
      "import": "./dist/configs/eslint/node.js",
      "require": "./dist/configs/eslint/node.cjs"
    },
    "./configs/eslint/typescript": {
      "types": "./dist/configs/eslint/typescript.d.ts",
      "import": "./dist/configs/eslint/typescript.js",
      "require": "./dist/configs/eslint/typescript.cjs"
    },
    "./configs/prettier": {
      "types": "./dist/configs/prettier/index.d.ts",
      "import": "./dist/configs/prettier/index.js",
      "require": "./dist/configs/prettier/index.cjs"
    },
    "./configs/stylelint": {
      "types": "./dist/configs/stylelint/index.d.ts",
      "import": "./dist/configs/stylelint/index.js",
      "require": "./dist/configs/stylelint/index.cjs"
    },
    "./configs/stylelint/base": {
      "types": "./dist/configs/stylelint/base.d.ts",
      "import": "./dist/configs/stylelint/base.js",
      "require": "./dist/configs/stylelint/base.cjs"
    },
    "./configs/stylelint/css": {
      "types": "./dist/configs/stylelint/css.d.ts",
      "import": "./dist/configs/stylelint/css.js",
      "require": "./dist/configs/stylelint/css.cjs"
    },
    "./configs/stylelint/scss": {
      "types": "./dist/configs/stylelint/scss.d.ts",
      "import": "./dist/configs/stylelint/scss.js",
      "require": "./dist/configs/stylelint/scss.cjs"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js",
      "require": "./dist/presets/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "eslint": ">=8",
    "prettier": ">=3",
    "stylelint": ">=16.1.0",
    "stylelint-config-standard": ">=36.0.0",
    "stylelint-config-standard-scss": ">=12.0.0",
    "stylelint-scss": ">=6.0.0",
    "eslint-plugin-import": ">=2.29.0",
    "eslint-plugin-react": ">=7.33.0",
    "eslint-plugin-react-hooks": ">=4.6.0",
    "eslint-plugin-jsx-a11y": ">=6.7.0",
    "eslint-plugin-node": ">=11.1.0",
    "@typescript-eslint/parser": ">=7.0.0",
    "@typescript-eslint/eslint-plugin": ">=7.0.0",
    "@angular-eslint/eslint-plugin": ">=17.0.0",
    "@angular-eslint/eslint-plugin-template": ">=17.0.0",
    "@angular-eslint/template-parser": ">=17.0.0",
    "eslint-config-prettier": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-node": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "@angular-eslint/eslint-plugin": {
      "optional": true
    },
    "@angular-eslint/eslint-plugin-template": {
      "optional": true
    },
    "@angular-eslint/template-parser": {
      "optional": true
    },
    "stylelint-config-standard-scss": {
      "optional": true
    },
    "stylelint-scss": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.7.0",
    "eslint-plugin-node": "^11.1.0",
    "@angular-eslint/eslint-plugin": "^17.0.0",
    "@angular-eslint/eslint-plugin-template": "^17.0.0",
    "@angular-eslint/template-parser": "^17.0.0",
    "prettier": "^3.2.5",
    "stylelint": "^16.1.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^12.0.0",
    "stylelint-scss": "^6.0.0",
    "stylelint-order": "^6.0.3",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0",
    "vitest": "^1.2.0"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint:eslint": "eslint src --ext .ts,.tsx",
    "lint:eslint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:style": "stylelint 'src/**/*.{css,scss}'",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test:run",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "packageManager": "npm@10.0.0"
}
