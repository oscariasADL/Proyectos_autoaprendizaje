{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "es2020"],
    "types": ["node"],
    "module": "es2020",
    "moduleResolution": "node",
    "target": "es2020",
    "skipLibCheck": true,
    "jsx": "react",
    "allowSyntheticDefaultImports": true
  },
  "include": ["lib"],
  "exclude": ["node_modules"]
}
