{
  "name": "@workspace/stencil",
  "version": "0.0.1",
  "description": "Designio - Stencil component starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/stencil/stencil.esm.js",
  "exports": {
    ".": {
      "import": "./dist/stencil/stencil.esm.js",
      "require": "./dist/stencil/stencil.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./my-component": {
      "import": "./dist/components/my-component.js",
      "types": "./dist/components/my-component.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ionic-team/stencil-component-starter.git"
  },
  "files": [
    "dist",
    "loader",
    "external"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --coverage",
    "test.cover": "stencil test --spec --collect-coverage",
    "test.watch": "stencil test --spec --watchAll",
    "generate": "stencil generate",
    "eslint": "eslint src",
    "lint": "npm run lint.ts && npm run lint.sass && npm run prettier -- --write --cache",
    "lint.fix": "npm run lint.ts.fix && npm run prettier -- --write --cache",
    "lint.sass": "stylelint \"src/**/*.scss\"",
    "lint.sass.fix": "npm run lint.sass -- --fix",
    "lint.ts": "npm run eslint",
    "lint.ts.fix": "npm run eslint -- --fix",
    "prettier": "npx prettier . --write"
  },
  "devDependencies": {
    "@stencil-community/eslint-plugin": "^0.7.2",
    "@stencil/angular-output-target": "^0.8.4",
    "@stencil/core": "^4.7.0",
    "@stencil/react-output-target": "^0.5.3",
    "@types/jest": "^29.5.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.4.0",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "prettier": "3.3.2",
    "puppeteer": "^22.13.0",
    "stylelint": "^16.6.1",
    "stylelint-config-standard-scss": "^13.1.0"
  },
  "license": "MIT",
  "dependencies": {
    "date-fns": "^3.6.0"
  }
}
