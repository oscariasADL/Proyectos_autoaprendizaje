{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "declaration": false,
    "experimentalDecorators": true,
    "lib": ["dom", "es2017"],
    "moduleResolution": "node",
    "module": "esnext",
    "target": "es2017",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": false,
    "declarationMap": false,
    "jsx": "react",
    "types": [
      "jest",
      "node",
      "react" // ⬅️ AÑADIR ESTO para que cargue los tipos de React/JSX
    ],
    "jsxFactory": "h"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
