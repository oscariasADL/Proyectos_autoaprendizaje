{
  "name": "@avaldigitallabs/adl-commons-design-system-frontend-designio",
  "version": "0.8.0",
  "description": "Designio",
  "repository": {
    "type": "git",
    "url": "github"
  },
  "author": "gustavo-espitia_adlover <gustavo.espitia@avaldigitallabs.com>",
  "license": "MIT",
  "scripts": {
    "prebuild": "mkdir -p packages/stencil/www/assets",
    "build": "npm run prebuild && lerna run build --concurrency=3",
    "start": "lerna run start",
    "watch": "lerna run watch --stream",
    "test": "lerna run test.cover",
    "lint": "lerna run lint --stream --parallel",
    "prettier": "lerna run prettier --stream --parallel",
    "clean": "lerna run clean -y",
    "postbootstrap": "lerna run build --concurrency=1",
    "customScript": "lerna run build-storybook && cp -R dist storybook-static",
    "storybook": "lerna run storybook",
    "execute": "npm run build && npm run customScript && npm run storybook"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "aws-amplify": "^6.4.4",
    "configcat-js": "^9.5.1",
    "copy-webpack-plugin": "^13.0.1",
    "form-data": "^4.0.4",
    "lottie-web": "^5.12.2"
  },
  "devDependencies": {
    "@avaldigitallabs/adl-commons-design-system-frontend-bavv-designio": "^0.7.8",
    "@avaldigitallabs/adl-commons-design-system-frontend-bocc-designio": "^0.0.53",
    "@avaldigitallabs/adl-commons-design-system-frontend-bpop-designio": "^0.7.10",
    "@npm-bbta/bbog-dig-dt-sherpa-lib": "^6.3.5",
    "@storybook/addon-backgrounds": "^9.0.8",
    "@types/node": "^18.17.0",
    "fs-extra": "^11.3.1",
    "lerna": "^8.1.5",
    "sass": "^1.90.0",
    "ts-dedent": "^2.2.0",
    "typescript": "^5.2.2"
  }
}
